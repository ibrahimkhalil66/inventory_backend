<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventory Categories</title>
</head>
<body>
    <table border="1">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            <% categories.forEach((category) => { %>
                <tr>
                    <td> <%= category.id %></td>
                    <td> <%= category.name %></td>
                    <td> <%= category.description %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
    
</body>
</html>

