<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Edit Category</title>
</head>
<body class="bg-gray-50 text-gray-800 font-sans antialiased">
    
    <%- include('../static/header') %>
    
    <div class="w-full max-w-xl bg-white p-8 rounded-2xl justify-self-center shadow-sm border border-gray-200 mt-8">
        <div class="mb-8 text-center">
            <h1 class="text-2xl font-bold text-gray-900">Edit <%= category.name %> #<%= category.id %></h1>
        </div>
        
        <form action="/inventory/category/edit/<%= category.id %>" method="post" class="space-y-5">
            

            <div>
                <label for="name" class="block text-sm font-medium text-gray-700 mb-1.5">Category Name</label>
                <input class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-shadow text-sm" type="text" name="name" id="name" required value="<%= category.name %>">
            </div>
            
            <div>
                <label for="description" class="block text-sm font-medium text-gray-700 mb-1.5">Category Description</label>
                <textarea class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-shadow text-sm resize-y" name="description" id="description" rows="4"><%= category.description %></textarea>
            </div>
            <div>
                <label for="items_count" class="block text-sm font-medium text-gray-700 mb-1.5">Category Items</label>
                <input disabled class="w-full border border-gray-300 bg-gray-200 cursor-not-allowed rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-shadow text-sm" type="text" name="name" id="items_count" required value="<%= category.items_count %>">
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            </div>

            <% if (typeof isExists !== 'undefined' && isExists) { %>
                <div class="p-3.5 rounded-lg bg-red-50 border border-red-200 text-sm text-red-600 font-medium">
                    <%= error %>
                </div>
            <% } %>

            <div class="pt-4 mt-6 border-t border-gray-100 flex items-center justify-between gap-4">
                <a href="/inventory/categories" class="text-sm font-medium text-gray-500 hover:text-gray-900 transition-colors">Cancel</a>
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 px-6 rounded-lg transition-colors shadow-sm w-full md:w-auto">
                    Save
                </button>
            </div>
            
        </form>
    </div>
    
</body>
</html>