<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>New Item</title>
</head>
<body class="bg-gray-50 text-gray-800 font-sans antialiased">
    
    <%- include('../static/header') %>
    
    <div class="w-full max-w-xl bg-white p-8 rounded-2xl justify-self-center shadow-sm border border-gray-200 mt-8">
        <div class="mb-8 text-center">
            <h1 class="text-2xl font-bold text-gray-900">Edit <%= item.name%> #<%= item.id %></h1>
        </div>
        
        <form action="/inventory/item/edit" method="post" class="space-y-5">

            
                <input class="hidden w-full bg-gray-50 border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-shadow text-sm" type="text" name="id" id="id" value="<%= item.id %>">
            <div>
                <label for="name" class="block text-sm font-medium text-gray-700 mb-1.5">Item Name</label>
                <input class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-shadow text-sm" type="text" name="name" id="name" required value="<%= item.name %>">
            </div>
            
            <div>
                <label for="description" class="block text-sm font-medium text-gray-700 mb-1.5">Item Description</label>
                <textarea class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-shadow text-sm resize-y" name="description" id="description" rows="4" value="<%= item.description %>"><%= item.description %>
                </textarea>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label for="price" class="block text-sm font-medium text-gray-700 mb-1.5">Price ($)</label>
                    <input class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-shadow text-sm" type="number" name="price" id="price" min="1" step="0.01" required value="<%= item.price %>">
                </div>
                
                <div>
                    <label for="stock_quantity" class="block text-sm font-medium text-gray-700 mb-1.5">Stock Quantity</label>
                    <input value="<%= item.stock_quantity %>" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-shadow text-sm" type="number" name="stock_quantity" id="stock_quantity" min="1" max="100" value="1" required>
                </div>
            </div>
            
            <div>
                <label for="category_id" class="block text-sm font-medium text-gray-700 mb-1.5">Category</label>
                <select class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-shadow text-sm bg-white" name="category_id" id="category_id" required>
                    <% categories.forEach((category) => { %>
                        <option value="<%= category.id %>" <%= category.id === item.category_id ? 'selected' : '' %>>
                            <%= category.name %>
                        </option>
                    <% }); %>
                </select>
            </div>

            <div class="pt-4 mt-6 border-t border-gray-100 flex items-center justify-between gap-4">
                <a href="/inventory/items" class="text-sm font-medium text-gray-500 hover:text-gray-900 transition-colors">Cancel</a>
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 px-6 rounded-lg transition-colors shadow-sm w-full md:w-auto">
                    Save
                </button>
            </div>
            
        </form>
    </div>
    
</body>
</html>